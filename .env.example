# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production + Preview).

# REQUIRED in production. The shared team password. If unset on a deployment,
# every page returns 503 (fail closed). If unset locally, the gate is skipped.
SITE_PASSWORD=

# Comments / lesson requests via giscus (GitHub Discussions).
# Get the category ID from https://giscus.app after enabling Discussions.
# Until it's set, comment boxes show a "not switched on yet" notice.
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
# Optional overrides (defaults shown):
# NEXT_PUBLIC_GISCUS_REPO=metin-akyol/claudefather
# NEXT_PUBLIC_GISCUS_REPO_ID=R_kgDOVpm74A
# NEXT_PUBLIC_GISCUS_CATEGORY=Ideas

# Optional: canonical URL. Vercel's production URL is used automatically if unset.
# NEXT_PUBLIC_SITE_URL=https://claudefather.example.com
